{
    "name": "elvisblanco1993/livewire-v4-recaptcha",
    "description": "Add Google reCAPTCHA (v3, v2, invisible) support to Laravel Livewire v4 components",
    "keywords": [
        "livewire",
        "livewire4",
        "recaptcha",
        "google-recaptcha",
        "laravel",
        "code wize technologies"
    ],
    "homepage": "https://github.com/elvisblanco1993/livewire-v4-recaptcha",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.1"
    },
    "autoload": {
        "psr-4": {
            "ElvisBlanco1993\\LivewireRecaptcha\\": "src/",
            "ElvisBlanco1993\\LivewireRecaptcha\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ElvisBlanco1993\\LivewireRecaptcha\\LivewireRecaptchaServiceProvider"
            ]
        }
    }
}
